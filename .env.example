# ---------------------------------------------------------------------------
# Valmiki LMS System — environment configuration
# Copy this file to `.env` at the repo root and fill in real values.
# ---------------------------------------------------------------------------

# --- Database (local PostgreSQL) -------------------------------------------
# Prisma reads DATABASE_URL for queries and DIRECT_URL for migrations.
# Against a plain local Postgres both point at the same server.
# When moving to Supabase Postgres, DATABASE_URL becomes the :6543 pooler URL
# and DIRECT_URL stays the :5432 direct URL. No schema changes required.
DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/valmiki_lms?schema=public"
DIRECT_URL="postgresql://postgres:REPLACE_ME@localhost:5432/valmiki_lms?schema=public"

# --- Supabase (Auth + Storage) ---------------------------------------------
# Auth: server-mediated username login (AD-02). Storage: private media bucket (AD-04).
# Find these in your Supabase project under Settings → API.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="REPLACE_ME"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"
SUPABASE_STORAGE_BUCKET="moments"

# Synthetic, non-routable email domain used to key Supabase Auth accounts
# to school-issued usernames (AD-02). Never receives mail.
AUTH_EMAIL_DOMAIN="users.valmiki.internal"

# --- API server -------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- School defaults --------------------------------------------------------
SCHOOL_TIMEZONE="Asia/Kolkata"

# --- Feature flags ----------------------------------------------------------
# Push *subscriptions* are collected regardless, so the device estate is warm
# when this flips. Only delivery is gated (D3). The in-app notification centre
# is the launch channel either way.
FEATURE_WEB_PUSH=false

# --- Web push / VAPID (D3 / F22) --------------------------------------------
# Only needed to actually deliver pushes. Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave blank until then — the app degrades to in-app notifications only.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@valmiki.internal"

# --- Frontend (Vite) --------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_API_URL="http://localhost:4000/api/v1"
