{
  "name": "@vig/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and the demo seed for the Valmiki LMS System.",
  "type": "module",
  "scripts": {
    "generate": "prisma generate --schema schema.prisma",
    "migrate": "prisma migrate dev --schema schema.prisma",
    "seed": "tsx seed.ts",
    "studio": "prisma studio --schema schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@vig/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
